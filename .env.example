# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Postgres connection string. Rated play (accounts, Elo, matchmaking,
# challenges) is disabled without it; guest rooms and training still work.
# Neon gives you one that looks like:
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Signs session tokens. Must be 16+ characters and is REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Password reset email, sent through Resend (https://resend.com). Mail goes
# out only when RESEND_API_KEY and MAIL_FROM are both set. Without them,
# development prints each email (reset link included) to the server console;
# production sends nothing and logs an error.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=24 Rated <no-reply@yourdomain.com>

# Public base URL for links in emails. REQUIRED in production for password
# resets (links are never built from the request Host header). In dev it
# falls back to the Vite origin, http://localhost:5173.
# APP_URL=https://two4gamerated.onrender.com

# Optional
PORT=3000
