# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Postgres connection string. Rated play (accounts, Elo, matchmaking,
# challenges) is disabled without it; guest rooms and training still work.
# Neon gives you one that looks like:
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Signs session tokens. Must be 16+ characters and is REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional
PORT=3000
